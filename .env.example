# ============================================================
# Multi-Modal RAG Knowledge Engine — Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=MultiModal-RAG-Engine
APP_VERSION=1.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Security & Authentication ---
# Set API_KEY to require X-API-Key header on endpoints (leave blank to disable auth)
API_KEY=
API_KEY_HEADER_NAME=X-API-Key
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# --- VLM / LLM Provider Configuration ---
# Choose provider: "gemini" or "openai"
VLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VLM_MODEL_NAME=gemini-1.5-flash
VLM_MAX_CONCURRENT=5
VLM_MAX_RETRIES=3
VLM_TIMEOUT_SECONDS=30.0

# --- Local Embedding Model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=384

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# --- Ingestion & Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_IMAGE_DIMENSION=100
MAX_FILE_SIZE_MB=50
DUPLICATE_STRATEGY=replace

# --- Retrieval & Guardrails ---
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=0.20
MAX_CONTEXT_CHARS=8000

# --- Local Directories ---
UPLOAD_DIR=./data/uploads
EXTRACTED_IMAGES_DIR=./data/extracted_images
