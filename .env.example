# ============================================================
# Multi-Modal RAG Knowledge Engine — Environment Configuration
# ============================================================

# --- Application ---
APP_NAME=MultiModal-RAG-Engine
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- VLM / LLM Provider Configuration ---
# Choose provider: "gemini" or "openai"
VLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VLM_MODEL_NAME=gemini-1.5-flash
VLM_MAX_CONCURRENT=5
VLM_MAX_RETRIES=3

# --- Local Embedding Model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# --- Ingestion & Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_IMAGE_DIMENSION=100

# --- Retrieval Defaults ---
DEFAULT_TOP_K=5

# --- Local Directories ---
UPLOAD_DIR=./data/uploads
EXTRACTED_IMAGES_DIR=./data/extracted_images
